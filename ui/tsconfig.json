{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/aave/**/*.ts",
    "src/aave/**/*.tsx",
    "src/aave-risk-main.tsx",
    "src/vite-env.d.ts",
    "src/components/ui/*.d.ts",
    "src/lib/*.d.ts"
  ]
}
